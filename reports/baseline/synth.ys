# Official synthesis flow for the baseline ntt_top: target-specific
# synthesis for a Lattice ECP5 (LFE5U-85F, CABGA381, speed grade 6), used
# together with nextpnr-ecp5 (see scripts/run_synthesis.sh) to obtain real
# post-route LUT/FF/DSP/BRAM counts and, via place-and-route, a real
# critical-path/Fmax measurement. See README.md, "Baseline hardware
# optimization (ECP5 target)".
#
# -nodsp keeps mod_mul's single 5x5 multiply (diff * tw) on LUT/carry-chain
# logic instead of a MULT18X18D hard macro.
read_verilog -sv ../../rtl/modular_arithmetic.v
read_verilog -sv ../../rtl/twiddle_rom.v
read_verilog -sv ../../rtl/butterfly_datapath.v
read_verilog -sv ../../rtl/coefficient_memory.v
read_verilog -sv ../../rtl/ntt_controller.v
read_verilog -sv ../../rtl/ntt_top.v
hierarchy -top ntt_top
synth_ecp5 -top ntt_top -nodsp -json ntt_top.json
stat
