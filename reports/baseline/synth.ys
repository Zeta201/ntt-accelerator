# Generic (technology-independent) synthesis of the baseline ntt_top for a
# gate/cell-count comparison. No FPGA target or timing library is used, so
# this produces generic synthesis statistics only -- no LUT/FF/BRAM counts
# and no timing (Fmax / critical path) are available from this flow.
read_verilog -sv ../../rtl/modular_arithmetic.v
read_verilog -sv ../../rtl/twiddle_rom.v
read_verilog -sv ../../rtl/butterfly_datapath.v
read_verilog -sv ../../rtl/coefficient_memory.v
read_verilog -sv ../../rtl/ntt_controller.v
read_verilog -sv ../../rtl/ntt_top.v
hierarchy -top ntt_top
synth -top ntt_top
stat
