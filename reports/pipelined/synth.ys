# Official synthesis flow for the pipelined ntt_top_pipelined: target-specific
# synthesis for a Lattice ECP5 (LFE5U-85F, CABGA381, speed grade 6), used
# together with nextpnr-ecp5 (see scripts/run_synthesis.sh) to obtain real
# post-route LUT/FF/DSP/BRAM counts and a real critical-path/Fmax
# measurement, on the same target and settings as the baseline. This
# experiment's RTL and schedule are unchanged -- only the synthesis target
# matches the baseline's -nodsp mapping; it has no S_COMPUTE state to merge
# (its controller already only has IDLE/LOAD/RUN).
#
# -nodsp keeps mod_mul's single 5x5 multiply (diff * tw) on LUT/carry-chain
# logic instead of a MULT18X18D hard macro.
read_verilog -sv ../../rtl/modular_arithmetic.v
read_verilog -sv ../../rtl/twiddle_rom.v
read_verilog -sv ../../rtl/butterfly_datapath.v
read_verilog -sv ../../rtl/coefficient_memory.v
read_verilog -sv ../../experiments/pipelined/rtl/ntt_controller_pipelined.v
read_verilog -sv ../../experiments/pipelined/rtl/ntt_top_pipelined.v
hierarchy -top ntt_top_pipelined
synth_ecp5 -top ntt_top_pipelined -nodsp -json ntt_top_pipelined.json
stat
