# Official synthesis flow for the N=16 ntt_top16: target-specific synthesis
# for a Lattice ECP5 (LFE5U-85F, CABGA381, speed grade 6), used together
# with nextpnr-ecp5 (see scripts/run_synthesis.sh) to obtain real post-route
# LUT/FF/DSP/BRAM counts and a real critical-path/Fmax measurement, on the
# same target and settings as the baseline.
#
# -nodsp keeps mod_mul's single 5x5 multiply (diff * tw) on LUT/carry-chain
# logic instead of a MULT18X18D hard macro.
read_verilog -sv ../../rtl/modular_arithmetic.v
read_verilog -sv ../../rtl/butterfly_datapath.v
read_verilog -sv ../../experiments/ntt16/rtl/twiddle_rom16.v
read_verilog -sv ../../experiments/ntt16/rtl/coefficient_memory16.v
read_verilog -sv ../../experiments/ntt16/rtl/ntt_controller16.v
read_verilog -sv ../../experiments/ntt16/rtl/ntt_top16.v
hierarchy -top ntt_top16
synth_ecp5 -top ntt_top16 -nodsp -json ntt_top16.json
stat
