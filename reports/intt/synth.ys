# Generic (technology-independent) synthesis of the INTT-capable ntt_top for
# a gate/cell-count comparison against the baseline, under the same flow and
# settings. No FPGA target or timing library is used, so this produces
# generic synthesis statistics only -- no LUT/FF/BRAM counts and no timing
# (Fmax / critical path) are available from this flow.
read_verilog -sv ../../rtl/modular_arithmetic.v
read_verilog -sv ../../rtl/butterfly_datapath.v
read_verilog -sv ../../rtl/coefficient_memory.v
read_verilog -sv ../../experiments/intt/rtl/twiddle_rom.v
read_verilog -sv ../../experiments/intt/rtl/ntt_controller.v
read_verilog -sv ../../experiments/intt/rtl/ntt_top.v
hierarchy -top ntt_top
synth -top ntt_top
stat
